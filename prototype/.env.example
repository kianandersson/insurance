# Copy to .env and fill in. .env is gitignored.

# --- App ---
# Shared login code shown on the sign-in screen.
DEMO_PASSWORD=change-me
# HMAC secret for the session cookie. Set a stable random value so sessions survive restarts.
SESSION_SECRET=
# Server port (hosts may inject their own).
PORT=3000
# Live AI extraction — read automatically by the Vercel AI SDK. Without it the transcript still
# streams, but the graph won't fill.
ANTHROPIC_API_KEY=

# --- Twilio ---
# Account SID identifies the account and signs the browser Voice token; From is the caller ID.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=+4593703142
# Public URL Twilio calls back on (TwiML + transcription webhooks).
PUBLIC_BASE_URL=https://your-deployed-host
# API Key signs the browser's Voice access token; the TwiML App routes the browser leg to
# /twiml/outgoing. Provisioned once against the account (see the one-off script in git history);
# the softphone runtime never uses the Account Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
