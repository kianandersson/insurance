# Copy to .env and fill in. .env is gitignored.

# Shared access code the stakeholder types on the login screen.
DEMO_PASSWORD=change-me

# HMAC secret for the session cookie. Set a stable random value in the deploy env
# so sessions survive restarts. Leave unset locally and a per-process value is used.
SESSION_SECRET=

# Port the server listens on. Hosts inject their own (Railway/Render/Fly set PORT).
PORT=3000

# --- Twilio (used from ticket 04 onward; creds already captured in
#     .scratch/prototype/.env from ticket 01) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+4593703142
# PUBLIC_BASE_URL=https://your-deployed-host   # for Twilio webhook callbacks
