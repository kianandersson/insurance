# Copy to .env and fill in. .env is gitignored.

# Shared access code the stakeholder types on the login screen.
DEMO_PASSWORD=change-me

# HMAC secret for the session cookie. Set a stable random value in the deploy env
# so sessions survive restarts. Leave unset locally and a per-process value is used.
SESSION_SECRET=

# Port the server listens on. Hosts inject their own (Railway/Render/Fly set PORT).
PORT=3000

# Anthropic API key for the live AI extraction (ticket 05). The Vercel AI SDK's Anthropic
# provider reads this automatically; Bun auto-loads this .env. Without it the transcript still
# streams, but the graph won't fill (extraction is skipped and logged).
ANTHROPIC_API_KEY=

# --- Twilio (used from ticket 04 onward; creds already captured in
#     .scratch/prototype/.env from ticket 01) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+4593703142
# PUBLIC_BASE_URL=https://your-deployed-host   # for Twilio webhook callbacks

# --- Twilio Voice / browser softphone (ticket 10) ---
# An API Key + Secret (distinct from Account SID / Auth Token) SIGN the browser's Voice access
# token; the TwiML App SID tells Twilio which Voice URL to fetch when the browser connects.
# DO NOT fill these in by hand: the server AUTO-PROVISIONS them on boot from the creds above
# (src/server/voice-setup.ts) and writes them back here. Run `bun run setup:voice` to do it ahead of
# time. To re-provision (e.g. PUBLIC_BASE_URL changed), delete the three lines and reboot.
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
